// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `zed: Open Default Settings` command
// from the command palette
{
  "agent": {
    "default_model": {
      "provider": "ollama",
      "model": "gpt-oss:20b"
    }
  },
  "tab_bar": {
    "show": true
  },
  "cursor_blink": false,
  "vim_mode": true,
  "ui_font_size": 14,
  "ui_font_family": "Alegreya Sans",
  "ui_font_weight": 450,
  "buffer_font_size": 12,
  "buffer_font_family": "TX-02",
  "buffer_font_fallbacks": ["JetBrainsMono Nerd Font", "JetBrains Mono"],
  "buffer_font_weight": 450,
  "buffer_font_features": {
    "calt": true,
    "liga": true
  },
  "buffer_line_height": "comfortable",
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Kanagawa Dragon"
  },
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": false
    }
  },
  "terminal": {
    "shell": {
      "program": "zsh"
    },
    "option_as_meta": true,
    "font_family": "TX-02",
    "font_weight": 450,
    "line_height": "comfortable",
    "font_features": {
      "calt": false,
      "liga": false
    }
  },
  "auto_signature_help": false,
  "wrap_guides": [
    100
  ],
  "preferred_line_length": 100,
  "show_wrap_guides": true,
  "load_direnv": "shell_hook",
  "lsp": {
    "zls": {
      "binary": {}
    },
    "biome": {
      "enable_lsp_tasks": true
    },
    "jdtls": {
      "settings": {
        "java": {
          "format": {
            "enabled": true,
            "settings": {
              "url": "file:///home/owi/projects/tigerbeetle/tigerbeetle/src/clients/java/eclipse-formatter.xml",
              "profile": "tigerbeetle-java-style"
            }
          },
          "configuration": {
            "updateBuildConfiguration": "interactive"
          },
          "implementationsCodeLens": {
            "enabled": true
          },
          "referencesCodeLens": {
            "enabled": true
          },
          "references": {
            "includeDecompiledSources": true
          },
          "signatureHelp": {
            "enabled": true
          },
          "completion": {
            "guessMethodArguments": true
          }
        }
      }
    },
    "rust-analyzer": {
      "initialization_options": {
        "checkOnSave": true,
        "check": {
          "extraArgs": ["--target-dir", "./target/check"]
        }
      }
    }
  },
  "file_types": {
    "HTML": [
      "tera"
    ]
  },
  "formatter": [
    {
      "language_server": {
        "name": "biome"
      }
    },
    {
      "language_server": {}
    }
  ],
  "languages": {
    "Nix": {
      "language_servers": [ "nil", "!nixd" ]
    }
  },
  "profiles": {
    "Focus": {
      "tab_bar": {
        "show": false,
        "show_nav_history_buttons": false
      },
      "toolbar": {
        "breadcrumbs": false,
        "quick_actions": false
      },
      "gutter": {
        "line_numbers": false,
        "folds": false,
        "breakpoints": false,
        "runnables": false,
        "min_line_number_digits": 0
      },
      "indent_guides": {
        "enabled": false
      },
      "current_line_highlight": "none",
      "scrollbar": {
        "show": "never",
        "cursors": false,
        "git_diff": false,
        "diagnostics": "none",
        "search_results": false,
        "selected_symbol": false
      }
    }
  },
  "theme_overrides": {
    "One Light": {
      "border": "#7D7D7DFF",
      "border.variant": "#BABABAFF",
      "elevated_surface.background": "#FFFFFFFF",
      "surface.background": "#FFFFFFFF",
      "background": "#FFFFFFFF",
      "text": "#000000FF",
      "icon": "#000000FF",
      "status_bar.background": "#FFFFFFFF",
      "title_bar.background": "#FFFFFFFF",
      "toolbar.background": "#FFFFFFFF",
      "tab_bar.background": "#FFFFFFFF",
      "tab.inactive_background": "#FFFFFFFF",
      "tab.active_background": "#FFFFFFFF",
      "panel.background": "#FFFFFFFF",
      "editor.foreground": "#000000FF",
      "editor.background": "#FFFFFFFF",
      "editor.gutter.background": "#FFFFFFFF",
      "editor.subheader.background": "#FFFFFFFF",
      "editor.active_line.background": "#FAFAFABF",
      "editor.highlighted_line.background": "#FFFFFFFF",
      "terminal.background": "#FFFFFFFF",
      "terminal.foreground": "#000000FF",
      "syntax": {
        "attribute": {
          "color": "#000000FF"
        },
        "boolean": {
          "color": "#6094C4FF"
        },
        "comment": {
          "color": "#B0B0B0FF"
        },
        "constant": {
          "color": "#6094C4FF"
        },
        "constructor": {
          "color": "#000000FF"
        },
        "function": {
          "color": "#000000FF"
        },
        "keyword": {
          "color": "#000000FF"
        },
        "label": {
          "color": "#000000FF"
        },
        "number": {
          "color": "#6094C4FF"
        },
        "operator": {
          "color": "#000000FF"
        },
        "preproc": {
          "color": "#000000FF"
        },
        "property": {
          "color": "#000000FF"
        },
        "punctuation": {
          "color": "#000000FF"
        },
        "punctuation.bracket": {
          "color": "#000000FF"
        },
        "punctuation.delimiter": {
          "color": "#000000FF"
        },
        "punctuation.list_marker": {
          "color": "#140D0CFF"
        },
        "punctuation.markup": {
          "color": "#000000FF"
        },
        "punctuation.special": {
          "color": "#000000FF"
        },
        "string": {
          "color": "#707070FF"
        },
        "string.escape": {
          "color": "#707070FF"
        },
        "string.regex": {
          "color": "#707070FF"
        },
        "string.special": {
          "color": "#707070FF"
        },
        "string.special.symbol": {
          "color": "#707070FF"
        },
        "tag": {
          "color": "#000000FF"
        },
        "title": {
          "color": "#000000FF"
        },
        "variable": {
          "color": "#000000FF"
        },
        "variable.special": {
          "color": "#000000FF"
        }
      },
      "panel.overlay_background": "#FFFFFFFF",
      "panel.overlay_hover": "#FFFFFFFF"
    }
  }
}
